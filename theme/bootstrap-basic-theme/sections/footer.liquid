<footer class="bg-dark text-light pt-5 pb-3 mt-5" data-bs-theme="dark">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-5">
        <h5>{{ section.settings.heading | default: shop.name }}</h5>
        {% if section.settings.text != blank %}<div class="text-secondary">{{ section.settings.text }}</div>{% endif %}
      </div>

      <div class="col-6 col-md-3 offset-md-1">
        <h6 class="text-uppercase small">Quick links</h6>
        <ul class="list-unstyled">
          {%- for link in section.settings.menu.links -%}
            <li><a class="link-secondary text-decoration-none" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="col-6 col-md-3">
        <h6 class="text-uppercase small">Newsletter</h6>
        {%- form 'customer', class: 'd-flex gap-2' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" class="form-control" placeholder="Email" required aria-label="Email">
          <button type="submit" class="btn btn-light">Join</button>
        {%- endform -%}
        {%- if form.posted_successfully? -%}<p class="small text-success mt-2">Thanks for subscribing!</p>{%- endif -%}
      </div>
    </div>

    <hr class="border-secondary mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between small text-secondary">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ]
}
{% endschema %}
