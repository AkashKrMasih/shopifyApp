<div class="container py-5">
  <h1 class="mb-4">{{ collection.title }}</h1>
  {% if collection.description != blank %}<div class="mb-4">{{ collection.description }}</div>{% endif %}
  {%- paginate collection.products by 12 -%}
    <div class="row row-cols-2 row-cols-md-4 g-4">
      {%- for product in collection.products -%}
        <div class="col">{% render 'product-card', product: product %}</div>
      {%- else -%}
        <p>No products found.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="mt-5" aria-label="Pagination">
        <ul class="pagination justify-content-center">
          {%- if paginate.previous -%}<li class="page-item"><a class="page-link" href="{{ paginate.previous.url }}">&laquo;</a></li>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<li class="page-item"><a class="page-link" href="{{ part.url }}">{{ part.title }}</a></li>
            {%- else -%}<li class="page-item active"><span class="page-link">{{ part.title }}</span></li>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<li class="page-item"><a class="page-link" href="{{ paginate.next.url }}">&raquo;</a></li>{%- endif -%}
        </ul>
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Collection" }
{% endschema %}
