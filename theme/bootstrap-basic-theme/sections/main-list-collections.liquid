<div class="container py-5">
  <h1 class="mb-4">Collections</h1>
  <div class="row row-cols-2 row-cols-md-3 g-4">
    {%- for collection in collections -%}
      <div class="col"><a class="text-decoration-none" href="{{ collection.url }}"><div class="card h-100"><div class="card-body"><h2 class="h5 mb-0">{{ collection.title }}</h2></div></div></a></div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collections list" }
{% endschema %}
